		transform: translateY(110%);
		font-style: italic;
	}
}

.root {
	position: relative;
	overflow: hidden;
	display: block;

	&:hover {
		.line.normal {
			transform: translateY(-110%);
		}

		.line.hover {
			transform: translateY(0);
		}
	}
}
