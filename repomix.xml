<file path="src/styles/globals.css">
*,
*::before,
*::after {
	box-sizing: border-box;
}

* {
	margin: 0;
}

html {
	font-feature-settings:
		'pnum' on,
		'lnum' on;
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
	text-size-adjust: 100%;
	text-rendering: optimizelegibility;

	::-webkit-scrollbar {
		display: none;
	}
}

body {
	min-height: 100vh;
	font-family:
		var(--font-vela-sans),
		system-ui,
		-apple-system,
		sans-serif;
	line-height: 1.5;
}

img,
picture,
video,
canvas,
svg {
	display: block;
	max-width: 100%;
}

input,
button,
textarea,
select {
	font: inherit;
	color: inherit;
}

button,
[type='button'],
[type='reset'],
[type='submit'] {
	cursor: pointer;
	appearance: auto;
}

textarea {
	resize: vertical;
}

a {
	color: inherit;
	text-decoration: inherit;
}

ul,
ol {
	padding: 0;
	list-style: none;
}

table {
	border-spacing: 0;
	border-collapse: collapse;
}

h1,
h2,
h3,
h4,
h5,
h6 {
	font: inherit;
	font-family: var(--font-bounded), 'Arial Narrow', sans-serif;
}

p,
h1,
h2,
h3,
h4,
h5,
h6 {
	overflow-wrap: break-word;
}

pre,
code,
kbd,
samp {
	font-family:
		ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
		'Courier New', monospace;
	font-size: 1em;
}

@media (prefers-reduced-motion: reduce) {
	*,
	*::before,
	*::after {
		scroll-behavior: auto !important;
		transition-duration: 0.01ms !important;
		animation-duration: 0.01ms !important;
		animation-iteration-count: 1 !important;
	}
}

:focus-visible {
	outline: 2px solid currentcolor;
	outline-offset: 2px;
}
