import styles from './Text.module.css'

type TextSize =
	| 'xs'
	| 'sm'
	| 'base'
	| 'lg'
	| 'xl'
	| 'xxl'
	| '2xl'
	| '3xl'
	| '4xl'
	| '5xl'
type TextWeight = 'regular' | 'medium' | 'semibold' | 'bold'

interface Props extends HTMLAttributes<HTMLElement> {
	as?: ElementType
	size?: TextSize
	weight?: TextWeight
	children: ReactNode
	className?: string
}

