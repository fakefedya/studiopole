	size = 'base',
	weight,
	children,
	className,
	...props
}: Props) => {
	return (
		<Tag
			className={cn(
				styles.root,
				styles[`size-${size}`],
				weight && styles[`weight-${weight}`],
				className,
			)}
			{...props}
		>
			{children}
		</Tag>
	)
}
